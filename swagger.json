{
  "openapi": "3.0.0",
  "info": {
    "title": "IT HUNT Backend REST API",
    "description": "Production REST API backend for IT HUNT Software Solutions & Tech Academy (Prayagraj, UP). Serving Admissions, Careers, Reviews, NIELIT Projects, Courses, User Management, and SuperAdmin metrics.",
    "version": "1.0.0",
    "contact": {
      "name": "IT HUNT Director & Lead",
      "email": "softtechithunt@gmail.com",
      "url": "https://ithunt.in"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Server Health Check",
        "responses": {
          "200": { "description": "Server is online and healthy" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register a new student/user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "phone": { "type": "string" },
                  "role": { "type": "string", "example": "student" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate user & return JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authentication token issued" }
        }
      }
    },
    "/api/students/register": {
      "post": {
        "summary": "Register student (Creates distinct records in auth 'users' and 'students' tables)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "phone": { "type": "string" },
                  "course": { "type": "string" },
                  "dob": { "type": "string" },
                  "gender": { "type": "string" },
                  "address": { "type": "string" },
                  "guardianName": { "type": "string" },
                  "guardianPhone": { "type": "string" },
                  "batch": { "type": "string" },
                  "bio": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Student registered successfully in users and students tables" }
        }
      }
    },
    "/api/students/login": {
      "post": {
        "summary": "Authenticate student & return auth token and student details profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Student authentication successful" }
        }
      }
    },
    "/api/students/me": {
      "get": {
        "summary": "Get authenticated student's profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Student profile fetched" }
        }
      },
      "put": {
        "summary": "Update authenticated student's profile details",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Student profile updated" }
        }
      }
    },
    "/api/students": {
      "get": {
        "summary": "Get all student records from students table (Admin/Faculty required)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of student detail records" }
        }
      }
    },
    "/api/users": {
      "get": {
        "summary": "Get all registered users (Admin authentication required)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User list" }
        }
      }
    },
    "/api/users/{id}": {
      "delete": {
        "summary": "Delete user account by ID (Admin authentication required)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "User account deleted successfully from DB and Firebase" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/api/admissions": {
      "post": {
        "summary": "Submit online admission or internship registration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fullName": { "type": "string" },
                  "email": { "type": "string" },
                  "phone": { "type": "string" },
                  "course": { "type": "string" },
                  "track": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Admission registration confirmed" }
        }
      },
      "get": {
        "summary": "Get all admissions (Admin authentication required)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Admissions list" }
        }
      }
    },
    "/api/admissions/{id}/slip": {
      "get": {
        "summary": "Generate official digital registration slip",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Registration slip metadata payload" }
        }
      }
    },
    "/api/careers/apply": {
      "post": {
        "summary": "Submit job or faculty application",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "phone": { "type": "string" },
                  "position": { "type": "string" },
                  "resumeLink": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Application recorded" }
        }
      }
    },
    "/api/reviews": {
      "get": {
        "summary": "Fetch public verified student reviews",
        "responses": {
          "200": { "description": "Verified reviews list" }
        }
      },
      "post": {
        "summary": "Submit a new student review",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "role": { "type": "string" },
                  "rating": { "type": "number", "example": 5 },
                  "reviewText": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Review created" }
        }
      }
    },
    "/api/admin/stats": {
      "get": {
        "summary": "Fetch SuperAdmin executive statistics",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Dashboard stats" }
        }
      }
    },
    "/api/admin/firebase/collections/{collection}": {
      "get": {
        "summary": "Fetch full collection details directly from Firebase Firestore / Cloud Storage",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "collection", "in": "path", "required": true, "schema": { "type": "string" }, "example": "students" }
        ],
        "responses": {
          "200": { "description": "Collection records fetched from Firebase Firestore" }
        }
      }
    },
    "/api/admin/firebase/collections/{collection}/{id}": {
      "get": {
        "summary": "Fetch specific document detail from Firebase Firestore",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "collection", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Document detail fetched from Firebase Firestore" }
        }
      }
    },
    "/api/admin/firebase/storage/files": {
      "get": {
        "summary": "List files from Firebase Cloud Storage bucket",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of files in Firebase Storage" }
        }
      }
    },
    "/api/certificates/verify/{certNo}": {
      "get": {
        "summary": "Public Verification of Official Student Certificate",
        "parameters": [
          { "name": "certNo", "in": "path", "required": true, "schema": { "type": "string" }, "example": "ITH-CERT-2026-0001" }
        ],
        "responses": {
          "200": { "description": "Certificate authenticity details" }
        }
      }
    },
    "/api/certificates": {
      "get": {
        "summary": "List all student certificates",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of issued certificates" }
        }
      },
      "post": {
        "summary": "Issue a new official student certificate",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "studentName": { "type": "string" },
                  "enrollmentNumber": { "type": "string" },
                  "courseName": { "type": "string" },
                  "grade": { "type": "string" },
                  "duration": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Certificate issued successfully" }
        }
      }
    },
    "/api/fees/record": {
      "post": {
        "summary": "Record a student fee payment & issue receipt",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "studentName": { "type": "string" },
                  "enrollmentNumber": { "type": "string" },
                  "courseName": { "type": "string" },
                  "amount": { "type": "number" },
                  "paymentMode": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Fee receipt generated" }
        }
      }
    },
    "/api/faculty": {
      "get": {
        "summary": "Get official faculty and mentor directory",
        "responses": {
          "200": { "description": "Faculty directory list" }
        }
      },
      "post": {
        "summary": "Register a new faculty member",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Faculty registered" }
        }
      }
    },
    "/api/attendance/mark": {
      "post": {
        "summary": "Mark student daily attendance",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Attendance logged" }
        }
      }
    },
    "/api/internships": {
      "get": {
        "summary": "List available software internship tracks",
        "responses": {
          "200": { "description": "Internships list" }
        }
      }
    },
    "/api/internships/apply": {
      "post": {
        "summary": "Apply for software internship",
        "responses": {
          "201": { "description": "Application submitted" }
        }
      }
    }
  }
}
